  userId    String   @unique
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Client Directory - Individual Contacts
model ClientContact {
  id        String        @id @default(cuid())
  companyId String
  company   ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  language  String? // Preferred language for emails (null = use system default)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([companyId])
  @@index([email])
}

// Feishu Integration
model FeishuBinding {
  id        String   @id @default(cuid())
  userId    String   @unique
  openId    String   @unique
  unionId   String?
  tenantKey String?
  nickname  String?
  avatarUrl String?
  userAccessTokenEncrypted String?
  refreshTokenEncrypted    String?
  tokenExpiresAt           DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([openId])
  @@index([unionId])
}

model FeishuNotification {
  id              String    @id @default(cuid())
  projectId       String
  videoId         String?
  userId          String
  scope           String
  commentIds      String[]
  uploaderId      String
  uploaderOpenId  String
  status          String    @default("PENDING")
  feishuMessageId String?
  errorMessage    String?
  retryCount      Int       @default(0)
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  video    Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user     User    @relation("FeishuNotificationSender", fields: [userId], references: [id], onDelete: Cascade)
  uploader User    @relation("FeishuNotificationUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([videoId])
  @@index([uploaderId])
  @@index([status])
  @@index([createdAt])
}

model Plan {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  priceCents   Int
  currency     String   @default("CNY")
  durationDays Int
  maxMembers   Int
  maxProjects  Int
  maxVideos    Int
  maxStorageGB Int
  active       Boolean  @default(true)
  sort         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@index([active, sort])
}

/// One commercial transaction. Amounts are stored in cents; the client never
/// supplies them. PAID and FULFILLED stay separate because the manual channel
/// writes both in one click while the wechat callback will only be able to
/// write PAID, leaving fulfilment retryable without double-charging.
model Order {
  id              String    @id @default(cuid())
  teamId          String
  planKey         String
  plan            Plan      @relation(fields: [planKey], references: [key], onDelete: Restrict)
  periods         Int       @default(1)
  amountCents     Int
  currency        String    @default("CNY")
  reference       String    @unique
  status          String    @default("OPEN") // OPEN, REPORTED, PAID, FULFILLED, CLOSED
  createdById     String
  reportedAt      DateTime?
  reportNote      String?
  paidAt          DateTime?
  fulfilledAt     DateTime?
  fulfilledById   String?
  periodStart     DateTime?
  periodEnd       DateTime?
  invoiceRequested Boolean   @default(false)
  invoiceTitle    String?
  invoiceTaxNo    String?
  closeReason     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Restrict, never Cascade: an order row IS the reconciliation evidence
  // (reference, reportNote, paidAt, the invoice fields). Deleting a team or a
  // login must not destroy it — same stance as planKey -> Plan above.
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdBy User             @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  fulfilledBy User?          @relation("OrderFulfiller", fields: [fulfilledById], references: [id], onDelete: Restrict)
  events    OrderEvent[]
  attempts  PaymentAttempt[]

  @@index([teamId, status])
  @@index([status, createdAt])
  @@index([planKey])
}

/// One attempt through one channel. Phase 1 writes exactly one `manual` row per
/// order; adding wechat later means inserting `wechat` rows, nothing else.
model PaymentAttempt {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  outTradeNo  String   @unique
  providerRef String?
  amountCents Int
  status      String   @default("CREATED") // CREATED, SUCCEEDED, FAILED
  raw         Json?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User     @relation("OrderEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  type        String
  note        String?
  at          DateTime @default(now())

  @@index([orderId, at])
}

// ── 平台运营：系统通知 + 用户反馈 ──

model PlatformAnnouncement {
  id        String   @id @default(cuid())
  title     String
  content   String
  // Legacy direct-message target. New announcements use AnnouncementAudienceRule.
  // null = broadcast (legacy); non-null = targeted at that one user.
  userId    String?
  user      User?    @relation("PlatformAnnouncementTarget", fields: [userId], references: [id], onDelete: Cascade)

  locale       String   @default("zh")
  type         String   @default("MESSAGE")
  status       String   @default("ACTIVE")
  primaryMode  String   @default("INBOX")
  priority     Int      @default(0)
  startAt      DateTime?
  endAt        DateTime?
  ackRequired  Boolean  @default(false)
  ctaLabel     String?
  ctaUrl       String?
  imageUrl     String?
  createdBy    String?
  creator      User?    @relation("PlatformAnnouncementCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  publishedAt  DateTime?
  audienceCount    Int?
  audienceResolvedAt DateTime?
  version      Int      @default(1)
  copiedFromId String?
  copiedFrom   PlatformAnnouncement?  @relation("AnnouncementVersions", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       PlatformAnnouncement[] @relation("AnnouncementVersions")
  isTest       Boolean  @default(false)
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  reads        PlatformAnnouncementRead[]
  rules        AnnouncementAudienceRule[]
  events       AnnouncementEvent[]
  auditLogs    AnnouncementAuditLog[]

  @@index([userId])
  @@index([createdAt])
  @@index([status, startAt, endAt])
  @@index([primaryMode, status])
  @@index([type, createdAt])
  @@index([copiedFromId])
}

model PlatformAnnouncementRead {
  id             String               @id @default(cuid())
  announcementId String
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation("PlatformAnnouncementReads", fields: [userId], references: [id], onDelete: Cascade)
  // Nullable: a row may exist for an impression/dismissal before the body was read.
  readAt         DateTime?
  acknowledgedAt DateTime?
  dismissedAt    DateTime?
  lastShownAt    DateTime?
  shownCount     Int                  @default(0)
  impressionCount Int                 @default(0)
  lastShownSessionId String?
  updatedAt      DateTime             @default(now()) @updatedAt

  @@unique([announcementId, userId])
  @@index([userId, lastShownAt])
}

model AnnouncementAudienceRule {
  id             String               @id @default(cuid())
  announcementId String
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  kind           String               // ALL / TEAM / USER / ROLE / PLAN / FEATURE / LOCALE / ACTIVE_STATUS
  value          String?
  mode           String               @default("INCLUDE") // INCLUDE / EXCLUDE
  createdAt      DateTime             @default(now())

  @@index([announcementId])
  @@index([kind, value])
}

model AnnouncementEvent {
  id             String               @id @default(cuid())
  announcementId String
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation("AnnouncementEvents", fields: [userId], references: [id], onDelete: Cascade)
  type           String               // IMPRESSION / READ / ACK / CLICK / DISMISS
  mode           String               // INBOX / BANNER / MODAL / TOAST
  beijingDay     String               // YYYY-MM-DD in Asia/Shanghai
  // Bounds growth: impressions/clicks once per user+mode+day; read/ack/dismiss once ever.
  dedupeKey      String               @unique
  occurredAt     DateTime             @default(now())

  @@index([announcementId, type, occurredAt])
  @@index([announcementId, beijingDay])
  @@index([userId, occurredAt])
  @@index([occurredAt])
}

model AnnouncementAuditLog {
  id             String               @id @default(cuid())
  announcementId String?
  announcement   PlatformAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  actorUserId    String
  actorLabel     String
  action         String               // CREATE / UPDATE / PUBLISH / PAUSE / RESUME / ARCHIVE / COPY / TEST_SEND / KILL_SWITCH / CONTROL_UPDATE
  detail         Json?
  createdAt      DateTime             @default(now())

  @@index([announcementId, createdAt])
  @@index([actorUserId, createdAt])
}

model AnnouncementControl {
  id                    String   @id @default("global")
  bannerModalPaused     Boolean  @default(false)
  modalMaxPerDay        Int      @default(1)
  modalCooldownMinutes  Int      @default(1440)
  modalMaxShowsPerUser  Int      @default(3)
  toastMaxPriority      Int      @default(20)
  updatedBy             String?
  updatedByLabel        String?
  updatedAt             DateTime @default(now()) @updatedAt
}

model PlatformFeedback {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("PlatformFeedback", fields: [userId], references: [id], onDelete: Cascade)
  content   String
  category  String? // 六枚类型标签之一，见 src/lib/feedback-categories.ts；不选类型就是 null
  status    String    @default("OPEN") // OPEN / RESOLVED
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// 在线客服（纯文字）。附件刻意不建模：当前产品只允许文本，避免引入 S3 上传、
// 图片解码和病毒扫描面。将来真要文件时再单独加 SupportAttachment + 迁移。
// ---------------------------------------------------------------------------

enum SupportConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum SupportMessageSenderType {
  VISITOR
  AGENT
  SYSTEM
}

enum SupportMessageVisibility {
  PUBLIC
  INTERNAL
}

enum SupportMessageKind {
  TEXT
  SYSTEM
}

enum SupportParticipantRole {
  VISITOR
  AGENT
}

model SupportVisitor {
  id             String   @id @default(cuid())
  // Cookie 里只放随机 token，库里存 sha256；备份泄漏不能直接当会话使用。
  sessionHash    String   @unique
  userId         String?
  name           String?
  email          String?
  locale         String   @default("zh")
  ipHash         String?
  userAgentHash  String?
  consentAt      DateTime?
  consentVersion String?
  lastSeenAt     DateTime @default(now())
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversations SupportConversation[]

  @@index([userId])
  @@index([lastSeenAt])
}

model SupportConversation {
  id                     String                      @id @default(cuid())
  publicId               String                      @unique @default(cuid())
  visitorId              String
  visitor                SupportVisitor              @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  userId                 String?
  teamId                 String?
  projectId              String?
  source                 String                      @default("WEB")
  pagePath               String?
  referrerHost           String?
  locale                 String                      @default("zh")
  status                 SupportConversationStatus   @default(OPEN)
  assigneeId             String?
  priority               String?
  tags                   String[]                    @default([])
  lastSeq                Int                         @default(0)
  lastMessageAt          DateTime                    @default(now())
  lastMessagePreview     String?
  lastMessageSenderType  SupportMessageSenderType?
  unreadForAgent         Int                         @default(0)
  unreadForVisitor       Int                         @default(0)
  firstVisitorMessageAt  DateTime?
  firstAgentReplyAt      DateTime?
  closedAt               DateTime?
  closedByType           String?
  closedById             String?
  reopenCount            Int                         @default(0)
  csatScore              Int?
  csatComment            String?
  csatAt                 DateTime?
  retentionUntil         DateTime?
  deletedAt              DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  participants  SupportParticipant[]
  messages      SupportMessage[]
  events        SupportEvent[]

  @@index([status, lastMessageAt])
  @@index([assigneeId, status])
  @@index([visitorId, createdAt])
  @@index([userId])
  @@index([teamId])
  @@index([projectId])
  @@index([lastMessageAt])
  @@index([retentionUntil])
  @@index([deletedAt])
}

model SupportParticipant {
  id               String                   @id @default(cuid())
  conversationId   String
  conversation     SupportConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  principalKey     String
  role             SupportParticipantRole
  visitorId        String?
  userId           String?
  lastReadSeq      Int                      @default(0)
  lastDeliveredSeq Int                      @default(0)
  lastTypingAt     DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([conversationId, principalKey])
  @@index([visitorId])
  @@index([userId])
}

model SupportMessage {
  id             String                        @id @default(cuid())
  conversationId String
  conversation   SupportConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  seq            Int
  senderType     SupportMessageSenderType
  senderId       String?
  clientId       String?
  body           String
  visibility     SupportMessageVisibility      @default(PUBLIC)
  kind           SupportMessageKind            @default(TEXT)
  createdAt      DateTime                      @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  notifications SupportNotification[]

  @@unique([conversationId, seq])
  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt])
  @@index([conversationId, visibility, seq])
}

model SupportEvent {
  id             String               @id @default(cuid())
  conversationId String?
  conversation   SupportConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  actorType      String
  actorId        String?
  type           String
  metadata       Json?
  ipHash         String?
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
  @@index([type, createdAt])
}

model SupportCannedResponse {
  id         String    @id @default(cuid())
  title      String
  body       String
  locale     String    @default("zh")
  shortcut   String?
  usageCount Int       @default(0)
  createdBy  String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([locale, title])
  @@index([shortcut])
}

model SupportSettings {
  id                         String   @id @default("default")
  businessHours              Json     @default("{}")
  offlineMessage             Json     @default("{}")
  firstResponseTargetMinutes Int      @default(15)
  retentionDays              Int      @default(180)
  csatEnabled                Boolean  @default(true)
  fallbackContacts           Json     @default("{}")
  quietHours                 Json     @default("{}")
  enabled                    Boolean  @default(true)
  updatedAt                  DateTime @updatedAt
}

model SupportNotification {
  id           String         @id @default(cuid())
  messageId    String
  message      SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel      String
  recipientKey String
  status       String         @default("PENDING")
  attempts     Int            @default(0)
  lastError    String?
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([messageId, channel, recipientKey])
  @@index([status, createdAt])
}

// In-app notification feed. One row per recipient so unread counts and
// per-recipient aggregation stay a single indexed query.
model UserNotification {
  id              String    @id @default(cuid())
  eventType       String
  category        String // TEAM | MENTION
  teamId          String
  projectId       String?
  videoId         String?
  commentId       String?
  actorUserId     String?
  actorName       String?
  recipientUserId String
  title           String
  body            String?
  deepLink        String?
  aggregateKey    String?
  aggregateCount  Int       @default(1)
  dedupeKey       String    @unique
  payload         Json?
  createdAt       DateTime  @default(now())
  lastEventAt     DateTime  @default(now())
  readAt          DateTime?
  seenAt          DateTime?
  clickedAt       DateTime?
  dismissedAt     DateTime?

  @@unique([recipientUserId, aggregateKey])
  @@index([recipientUserId, teamId, category, readAt, lastEventAt])
  @@index([teamId, lastEventAt])
  @@index([projectId, lastEventAt])
  @@index([commentId])
}

// Event-level idempotency log. Aggregated rows update one feed row, but every
// source event still gets a unique dedupeKey so retries cannot inflate counts.
model UserNotificationEvent {
  id              String   @id @default(cuid())
  dedupeKey       String   @unique
  notificationId  String?
  eventType       String
  teamId          String
  projectId       String?
  recipientUserId String
  entityId        String?
  createdAt       DateTime @default(now())

  @@index([recipientUserId, createdAt])
  @@index([teamId, createdAt])
  @@index([notificationId])
}

model CommentMention {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
  @@index([commentId])
}

model UserNotificationDelivery {
  id             String   @id @default(cuid())
  notificationId String
  channel        String // EMAIL | PUSH | APPRISE | FEISHU
  recipient      String?
  success        Boolean  @default(false)
  statusCode     Int?
  error          String?
  providerId     String?
  sentAt         DateTime @default(now())

  @@unique([notificationId, channel, recipient])
  @@index([channel, sentAt])
  @@index([success, sentAt])
}
