// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  phone               String?            @unique
  // HMAC of the normalised phone; the searchable form once the column above becomes ciphertext.
  phoneHash           String?            @unique
  username            String?            @unique
  password            String
  name                String?
  avatarUrl           String?
  onboardingCompleted Boolean            @default(true)
  role                UserRole           @default(ADMIN)
  isPlatformAdmin     Boolean            @default(false)
  projectAccessScope  ProjectAccessScope @default(ALL_PROJECTS)
  // Preferred interface/content locale. Null follows the platform-wide language setting.
  locale              String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  projects           Project[]
  createdTeams       Team[]              @relation("TeamCreator")
  teamMemberships    TeamMember[]
  teamJoinRequests   TeamJoinRequest[]
  comments           Comment[]
  passkeys           PasskeyCredential[]
  pushSubscriptions  PushSubscription[]
  calendarToken      CalendarToken?
  savedViews         AdminSavedView[]
  projectMemberships ProjectMember[]
  wechatIdentities   WechatIdentity[]
  feishuBinding      FeishuBinding?
  feishuNotificationsSent     FeishuNotification[] @relation("FeishuNotificationSender")
  feishuNotificationsReceived FeishuNotification[] @relation("FeishuNotificationUploader")
  ordersCreated               Order[]              @relation("OrderCreator")
  ordersFulfilled             Order[]              @relation("OrderFulfiller")
  orderEventsAsActor          OrderEvent[]         @relation("OrderEventActor")
  platformAnnouncements       PlatformAnnouncement[] @relation("PlatformAnnouncementTarget")
  platformAnnouncementsCreated PlatformAnnouncement[] @relation("PlatformAnnouncementCreator")
  platformAnnouncementReads   PlatformAnnouncementRead[] @relation("PlatformAnnouncementReads")
  announcementEvents          AnnouncementEvent[]        @relation("AnnouncementEvents")
  platformFeedback            PlatformFeedback[]         @relation("PlatformFeedback")

  @@index([locale])
}

// WeChat identities are separate from admin users. The unionId index allows a
// future mini-program identity to be linked to the same person safely.
model WechatIdentity {
  id        String   @id @default(cuid())
  userId    String?
  platform  String   @default("WEB")
  openId    String
  unionId   String?
  nickname  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([platform, openId])
  @@index([unionId])
  @@index([userId])
}

// Saved filter/sort presets for the admin Projects Dashboard.
// Per-user; the `state` blob is the SerializedFilterState from src/lib/projects-filter.ts
model AdminSavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ProjectAccessScope {
  ALL_PROJECTS
  ASSIGNED_ONLY
}

// Project-level capability. Team OWNER/ADMIN are implicit PROJECT_ADMIN;
// a TeamMember's defaultProjectRole applies when no ProjectMember override exists.
enum ProjectRole {
  PROJECT_ADMIN
  EDITOR
  REVIEWER
}

model DurableTask {
  id          String   @id @default(cuid())
  kind        String
  dedupeKey   String   @unique
  payload     Json
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([availableAt, createdAt])
}

model Team {
  // 号由 src/lib/team-id.ts 显式发（6 位数字），刻意不给默认值：漏写 id 就该报错，
  // 而不是悄悄长回一枚旧形状的号。库级 CHECK 见 prisma/migrations。
  id          String   @id
  name        String
  slug        String   @unique
  shareKey    String   @unique
  avatarUrl   String?
  status      String   @default("ACTIVE")
  createdById String
  subscriptionPlan       String   @default("TRIAL")
  subscriptionStartedAt  DateTime @default(now())
  subscriptionExpiresAt  DateTime?
  createdBy   User     @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         TeamMember[]
  projects        Project[]
  invites         TeamInvite[]
  joinRequests    TeamJoinRequest[]
  settings        TeamSettings?
  clientCompanies ClientCompany[]
  featureGrants   TeamFeatureGrant[]
  quota           TeamQuota?
  projectGroups   ProjectGroup[]
  orders          Order[]
  auditEvents     TeamAuditEvent[]

  @@index([createdById])
}

model PlatformFeature {
  key            String   @id
  name           String
  category       String
  defaultEnabled Boolean  @default(true)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  grants TeamFeatureGrant[]
}

model TeamFeatureGrant {
  id         String    @id @default(cuid())
  teamId     String
  featureKey String
  enabled    Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  feature PlatformFeature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([teamId, featureKey])
  @@index([featureKey])
}

model TeamQuota {
  id           String   @id @default(cuid())
  teamId       String   @unique
  maxMembers   Int      @default(10)
  maxProjects  Int      @default(5)
  maxVideos    Int      @default(50)
  maxStorageGB Int      @default(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // PLAN = written by fulfilOrder from a Plan; MANUAL = ops edited it in the
  // console. Default is PLAN on purpose: the provenance of existing rows is
  // unknowable, and defaulting to MANUAL would show "quota will be reset" for
  // every team on every confirmation until nobody reads it any more.
  source         String   @default("PLAN") // PLAN, MANUAL
  sourceOrderId  String?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// Membership lifecycle audit. actor/target are plain strings so deleting a
// user does not erase the record of what happened.
model TeamAuditEvent {
  id           String   @id @default(cuid())
  teamId       String
  actorUserId  String?
  targetUserId String?
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([teamId, action])
  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

model TeamActivationCard {  id                String    @id @default(cuid())
  codeHash          String    @unique
  codeLast4         String
  planKey           String    @default("MONTHLY")
  durationDays      Int       @default(30)
  maxMembers        Int       @default(10)
  maxStorageGB      Int       @default(50)
  maxProjects       Int       @default(0)
  maxVideos         Int       @default(0)
  status            String    @default("AVAILABLE")
  redeemedAt        DateTime?
  redeemedByTeamId  String?
  redeemedByUserId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([redeemedByTeamId])
}

model TeamSettings {
  id     String @id @default(cuid())
  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  defaultWatermarkEnabled              Boolean @default(true)
  defaultWatermarkText                 String?
  defaultWatermarkPositions            String  @default("center")
  defaultWatermarkOpacity              Int     @default(30)
  defaultWatermarkFontSize             String  @default("medium")
  defaultApplyPreviewLut               Boolean @default(true)
  maxUploadSizeGB                      Int     @default(1)
  defaultTimestampDisplay              String  @default("TIMECODE")
  defaultUsePreviewForApprovedPlayback Boolean @default(false)
  defaultAllowClientAssetUpload        Boolean @default(false)
  defaultAllowReverseShare             Boolean @default(true)
  defaultShowClientTutorial            Boolean @default(true)
  defaultAllowAssetDownload            Boolean @default(true)
  defaultClientCanApprove              Boolean @default(true)
  autoApproveProject                   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String           @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole         @default(MEMBER)
  status    TeamMemberStatus @default(ACTIVE)
  // Per-team project visibility. User.projectAccessScope is only the account
  // default for newly created memberships; this column is the runtime authority.
  projectAccessScope ProjectAccessScope @default(ALL_PROJECTS)
  // Used for MEMBER when no ProjectMember override exists. OWNER/ADMIN ignore it.
  defaultProjectRole ProjectRole        @default(REVIEWER)
  teamNickname   String?
  teamProfession String?
  department     String?
  bio            String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  // Server-side heartbeat only. Null means this member has never been seen by
  // the heartbeat collector; it must not be backfilled with updatedAt.
  lastActiveAt DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, lastActiveAt])
  @@index([teamId, projectAccessScope])
}

model TeamInvite {
  id          String       @id @default(cuid())
  teamId      String
  // LINK invitations carry no contact: possession of the token is the invite.
  method      InviteMethod @default(PHONE)
  email       String?
  phone       String?
  phoneHash     String?
  role        TeamRole     @default(MEMBER)
  projectAccessScope ProjectAccessScope @default(ALL_PROJECTS)
  defaultProjectRole ProjectRole        @default(REVIEWER)
  token       String       @unique
  status      InviteStatus @default(PENDING)
  createdById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  declinedAt  DateTime?
  createdAt   DateTime     @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projects TeamInviteProject[]

  @@index([teamId, status])
  @@index([teamId, method, status])
  @@index([createdById])
  @@index([expiresAt])
}

// Project grants carried by an invite. Accepting the invite writes these rows
// into ProjectMember; pending invites read them back in the member console.
model TeamInviteProject {
  id        String      @id @default(cuid())
  inviteId  String
  projectId String
  role      ProjectRole @default(REVIEWER)

  invite  TeamInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([inviteId, projectId])
  @@index([projectId])
}

model TeamJoinRequest {
  id           String            @id @default(cuid())
  teamId       String
  userId       String
  message      String?
  status       JoinRequestStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, status])
  @@index([userId])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamMemberStatus {
  ACTIVE
  DISABLED
}

enum InviteMethod {
  PHONE
  LINK
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Project {
  id              String  @id @default(cuid())
  projectCode     String
  title           String
  slug            String  @unique
  shareSlug       String
  description     String?
  companyName     String? // Optional company/brand name (display priority: companyName → primary recipient → 'Client')
  sharePassword   String?
  authMode        String  @default("PASSWORD") // Authentication mode: PASSWORD, OTP, BOTH, or NONE
  guestMode       Boolean @default(false) // Allow guest access with limited view (videos only, no comments/approval)
  guestLatestOnly Boolean @default(true) // Guests can only view latest version of each video
  guestShowPhotos Boolean @default(false) // Show photo albums to guests (view-only, downloads stay blocked)
  // 受限项目（对标 frame.io restricted）：true 时仅项目成员（ProjectMember）与团队 OWNER/ADMIN 可见，普通成员不可见。
  restricted      Boolean @default(false)

  // Revision tracking (optional)
  enableRevisions Boolean @default(false)
  maxRevisions    Int     @default(3)

  status          ProjectStatus @default(IN_REVIEW)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  approvedAt      DateTime?
  approvedVideoId String? // ID of the video that was approved (null if not approved)

  // Comment restrictions
  restrictCommentsToLatestVersion Boolean @default(false)
  hideFeedback                    Boolean @default(false)

  // Comment timestamp display for this project (stored at creation; editable per project)
  // AUTO = MM:SS or HH:MM:SS based on video length, TIMECODE = HH:MM:SS:FF (or DF)
  timestampDisplay String @default("TIMECODE")

  // Video processing settings
  previewResolution  String  @default("720p") // "720p", "1080p", or "2160p" (originals can be any resolution including 2160p)
  skipTranscoding    Boolean @default(false) // Skip transcoding entirely — serve original file directly
  watermarkEnabled   Boolean @default(true) // Enable/disable watermarks for this project
  watermarkText      String? // Custom watermark text (null = use default format)
  watermarkPositions String  @default("center") // comma-separated: center, top-left, top-right, bottom-left, bottom-right
  watermarkOpacity   Int     @default(30) // Opacity percentage (10-100)
  watermarkFontSize  String  @default("medium") // small, medium, large
  applyPreviewLut    Boolean @default(true) // Apply preview LUT during transcoding (for color-calibrated previews)

  // Client share page settings
  allowAssetDownload     Boolean @default(true) // Allow clients to download video assets when project is approved
  allowPhotoDownload     Boolean @default(true) // Allow clients to download photos from photo albums
  allowClientAssetUpload Boolean @default(false) // Allow clients to upload file attachments on comments
  clientCanApprove       Boolean @default(true) // Allow clients to approve videos (false = admin only)
  allowReverseShare      Boolean @default(true) // Allow clients to upload files directly to the project (reverse share)

  // Approved playback settings
  usePreviewForApprovedPlayback Boolean @default(false) // Use browser-compatible preview instead of original after approval

  // Client tutorial
  showClientTutorial Boolean @default(true) // Show interactive tutorial overlay for first-time visitors

  // Due date tracking
  dueDate     DateTime? // Optional project deadline
  dueReminder String? // NONE, DAY_BEFORE, WEEK_BEFORE

  // Client notification settings (per-project)
  // Note: Approval emails are always IMMEDIATE regardless of this setting
  clientNotificationSchedule String    @default("HOURLY") // IMMEDIATE, HOURLY, DAILY, WEEKLY
  clientNotificationTime     String? // "09:00" for daily, "Monday 09:00" for weekly
  clientNotificationDay      Int? // 0-6 for weekly (0 = Sunday)
  lastClientNotificationSent DateTime?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  // Client directory link (optional)
  clientCompanyId String?
  clientCompany   ClientCompany? @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)

  // Admin-made folder that files this project in the team console (optional, one folder per project)
  groupId String?
  group   ProjectGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  videos            Video[]
  folders           ProjectFolder[]
  comments          Comment[]
  securityEvents    SecurityEvent[]
  analytics         VideoAnalytics[]
  recipients        ProjectRecipient[] // Multiple email recipients
  notificationQueue NotificationQueue[] // Pending notifications
  sharePageAccesses SharePageAccess[] // Share page authentication tracking
  shareLinks        ShareLink[] // Independent share records and scopes
  projectUploads    ProjectUpload[] // Client-submitted files via reverse share
  photoAlbums       PhotoAlbum[] // Photo gallery albums
  recycleBinItems   RecycleBinItem[]
  members           ProjectMember[]
  inviteProjects    TeamInviteProject[]
  feishuNotifications    FeishuNotification[]

  @@unique([teamId, projectCode])
  @@unique([teamId, shareSlug])
  @@index([clientCompanyId])
  @@index([groupId])
  @@index([teamId])
  @@index([teamId, createdAt])
}

enum ProjectStatus {
  IN_REVIEW
  APPROVED
  SHARE_ONLY
  ARCHIVED
}

model ProjectRecipient {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email                String?
  phone                String?
  phoneHash            String?
  name                 String?
  isPrimary            Boolean  @default(false)
  receiveNotifications Boolean  @default(true) // Per-recipient notification toggle
  createdAt            DateTime @default(now())

  @@index([projectId])
  @@index([projectId, email])
  @@index([projectId, phone])
  @@index([projectId, phoneHash])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(REVIEWER)
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
}

model Video {
  id           String  @id @default(cuid())
  projectId    String
  folderId     String?
  name         String // Name to distinguish different videos in a project (required)
  version      Int // 1, 2, 3 (for revisions)
  versionLabel String // "v1", "v2", "v3" or custom

  // Original file
  originalFileName    String
  originalFileSize    BigInt
  originalStoragePath String
  fileType            String?

  // Upload metadata
  uploadedBy     String?
  uploadedByName String?

  // Video metadata
  duration Float // in seconds
  width    Int
  height   Int
  fps      Float?
  codec    String?

  // Processing status
  status             VideoStatus @default(UPLOADING)
  uploadProgress     Int         @default(0) // 0-100 percentage
  processingProgress Float       @default(0)
  processingError    String?

  // Tencent Cloud MPS/HLS processing. Existing MP4 preview fields remain
  // populated for older videos and local-FFmpeg fallback jobs.
  mpsTaskId String?
  mpsStatus String?
  mpsError  String?
  hlsPath   String?

  // High-bitrate H.264/AAC playback proxy for the optional source-quality
  // mode. This is not the uploaded original and is never used as a download.
  sourceQualityPath  String?
  sourceQualityError String?
  sourceQualityBytes BigInt?

  // Preview versions (watermarked)
  preview2160Path String?
  preview1080Path String?
  preview720Path  String?
  thumbnailPath   String?

  // Clean (non-watermarked) previews for approved playback
  cleanPreview2160Path String?
  cleanPreview1080Path String?
  cleanPreview720Path  String?

  // Per-video approval
  approved     Boolean            @default(false)
  approvedAt   DateTime?
  reviewStatus VideoReviewStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Recycle bin: the row stays addressable (with its comments, assets and
  // analytics) until the item expires. Reads are filtered by the client extension
  // in src/lib/db.ts; tombstone-aware callers opt out with INCLUDE_DELETED.
  deletedAt DateTime?

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder       ProjectFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sourceUpload ProjectUpload?   @relation("ProjectUploadVideo")
  analytics    VideoAnalytics[]
  assets       VideoAsset[]
  comments     Comment[]
  feishuNotifications FeishuNotification[]

  @@unique([projectId, name, version])
  @@index([projectId, version])
  @@index([projectId, name])
  @@index([folderId])
  @@index([projectId, deletedAt])
  @@index([projectId, createdAt])
}

/**
 * Team-level folder that files projects together in the console.
 * Distinct from ProjectFolder, which groups videos *inside* one project.
 */
model ProjectGroup {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Deleting a folder takes its subfolders with it; projects never go along
  // (Project.groupId is ON DELETE SET NULL).
  parent   ProjectGroup?    @relation("ProjectGroupTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ProjectGroup[]   @relation("ProjectGroupTree")
  projects Project[]

  // Names are unique among siblings rather than team-wide ("初稿" under two clients is
  // normal), enforced by two partial unique indexes in the migration — which
  // `migrate dev` cannot represent, so these are applied with `migrate deploy`.
  @@index([teamId])
  @@index([teamId, parentId])
  @@index([parentId])
}

model ProjectFolder {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videos  Video[]

  @@unique([projectId, name])
  @@index([projectId])
}

model VideoAsset {
  id      String @id @default(cuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  // File information
  fileName         String // ASCII storage name, matches the object key
  originalFileName String? // What the uploader named the file, Unicode preserved
  fileSize         BigInt
  fileType         String // MIME type (e.g., "application/octet-stream", "image/jpeg", "audio/mpeg")
  storagePath      String // Path in storage system
  category         String? // Optional category: "image", "audio", "project", "other"

  // Upload metadata
  uploadedBy          String? // User ID or "client" for client uploads
  uploadedByName      String? // Display name of uploader
  uploadedBySessionId String? // Stable share/admin session identifier for pending asset ownership

  uploadCompletedAt DateTime? // null until file transfer finishes; orphaned records stay null

  // Comment attachment (optional link to comment)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId])
  @@index([videoId, category])
  @@index([videoId, uploadCompletedAt])
  @@index([videoId, uploadedBySessionId])
  @@index([commentId])
}

// Client-submitted files via the reverse share feature (project-level, not attached to a video)
model ProjectUpload {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fileName         String
  originalFileName String?
  fileSize         BigInt
  fileType         String  @default("application/octet-stream")
  storagePath      String
  thumbnailPath    String? // Generated by worker for image/video uploads
  category         String?

  uploadedBySessionId String?
  uploadedByName      String?
  uploadedByEmail     String?

  uploadCompletedAt DateTime? // null until file transfer finishes; orphaned records stay null

  transcodeStatus   String  @default("NONE") // NONE, PROCESSING, READY, ERROR — the worker writes these (src/worker), and tsconfig excludes src/worker from type checking, so this list is the contract: keep it in step with the literals there.
  transcodeProgress Int     @default(0)
  transcodeError    String?
  sourceVideoId     String? @unique
  sourceVideo       Video?  @relation("ProjectUploadVideo", fields: [sourceVideoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, createdAt])
  @@index([projectId, uploadCompletedAt])
  @@index([uploadedBySessionId])
}

// Photo gallery album (project-level, admin-managed)
model PhotoAlbum {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name String

  coverPhotoId String?
  coverPhoto   Photo?  @relation("AlbumCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos Photo[]

  @@index([projectId])
}

model Photo {
  id      String     @id @default(cuid())
  albumId String
  album   PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  fileName         String // ASCII storage name, matches the object key
  originalFileName String? // What the uploader named the file, Unicode preserved
  fileSize         BigInt
  fileType         String
  storagePath      String
  thumbnailPath    String? // Generated by worker (webp, 512px)
  previewPath      String? // Generated by worker (webp, 2048px) — served in the lightbox instead of multi-MB originals
  width            Int?
  height           Int?

  uploadedBy     String? // Admin user ID
  uploadedByName String?

  uploadCompletedAt DateTime? // null until file transfer finishes; orphaned records stay null

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverOf PhotoAlbum[] @relation("AlbumCover")

  @@index([albumId])
  @@index([albumId, uploadCompletedAt])
}

model RecycleBinItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemType    String
  itemName    String
  metadata    Json?
  paths       Json
  directories Json
  deletedAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([projectId, deletedAt])
  @@index([expiresAt])
}

enum VideoReviewStatus {
  PENDING_REVIEW
  IN_REVIEW
  FEEDBACK_COMPLETE
  APPROVED
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  ERROR
  ROLLED_BACK
}

model Comment {
  id           String   @id @default(cuid())
  projectId    String
  videoId      String // All comments must be video-specific
  videoVersion Int? // track which version this comment was for
  timecode     String // HH:MM:SS:FF format (e.g., "00:00:32:15" for 32 seconds 15 frames at given FPS)
  content      String
  authorName   String? // made optional to allow anonymous comments
  authorEmail  String?
  isInternal   Boolean  @default(false) // true = from studio, false = from client
  visibility   String   @default("PUBLIC") // PUBLIC = 成员与共享链接查看者均可见；INTERNAL = 仅限拥有权限的成员查看（不影响 isInternal 的来源语义）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resolved     Boolean  @default(false)

  // Annotation support
  timecodeEnd String? // Optional end timecode for time range comments
  annotations Json? // JSONB storing drawing annotation shapes

  // Admin user tracking (for internal comments)
  userId String? // Admin user who created this comment
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Admin reply functionality
  parentId String? // if this is a reply to another comment
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  video   Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  assets  VideoAsset[]
  mentions CommentMention[]

  @@index([projectId])
  @@index([videoId])
  @@index([parentId])
  @@index([userId])
  @@index([projectId, createdAt])
}

model NotificationQueue {
  id        String @id @default(cuid())
  projectId String
  type      String // CLIENT_COMMENT, ADMIN_REPLY

  // Dual tracking for admin vs client notifications
  sentToClients Boolean   @default(false)
  sentToAdmins  Boolean   @default(false)
  clientSentAt  DateTime?
  adminSentAt   DateTime?

  // Retry and failure tracking
  clientAttempts Int     @default(0) // Number of send attempts to clients
  adminAttempts  Int     @default(0) // Number of send attempts to admins
  clientFailed   Boolean @default(false) // Permanently failed to send to clients
  adminFailed    Boolean @default(false) // Permanently failed to send to admins
  lastError      String? // Last error message for debugging

  data      Json // Stores: commentId, videoId, videoName, authorName, content, timestamp, isReply, etc.
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sentToClients])
  @@index([projectId, sentToAdmins])
  @@index([sentToAdmins, createdAt])
  @@index([clientFailed, adminFailed])
}

model Settings {
  id String @id @default("default")

  // Language / i18n
  language String @default("en") // UI language code (en, nl, de, fr, etc.)

  // Appearance
  defaultTheme String @default("auto") // "light", "dark", or "auto" (system preference)
  accentColor  String @default("blue") // Preset accent color name

  // Company Branding
  companyName         String? @default("Studio") // Displayed in feedback/comments
  brandingLogoPath    String? // Path to uploaded custom SVG logo
  brandingFaviconPath String? // Path to uploaded custom favicon (svg/png/ico)
  emailHeaderStyle    String  @default("LOGO_AND_NAME") // NONE, LOGO_ONLY, NAME_ONLY, LOGO_AND_NAME

  // 对公转账信息（一期唯一收款通道）。刻意不掩码：客户就是往这个账号打钱。
  // 真密钥类字段（微信支付那三项）走 env，不进这张表 —— GET /api/settings 是整行展开。
  transferAccountName String?
  transferAccountNo   String?
  transferBank        String?
  transferNote        String?
  transferQrPath      String?

  // SMTP Email Configuration
  smtpServer      String?
  smtpPort        Int?    @default(587)
  smtpUsername    String?
  smtpPassword    String?
  smtpFromAddress String?
  smtpSecure      String? @default("STARTTLS") // Options: "STARTTLS", "TLS", "NONE"

  // Domain Configuration
  appDomain String? // e.g., "https://yourdomain.com"

  // Default Video Processing Settings
  defaultPreviewResolution  String? @default("720p")
  defaultSkipTranscoding    Boolean @default(false)
  defaultWatermarkEnabled   Boolean @default(true)
  defaultWatermarkText      String?
  defaultWatermarkPositions String  @default("center") // comma-separated: center, top-left, top-right, bottom-left, bottom-right
  defaultWatermarkOpacity   Int     @default(30) // Opacity percentage (10-100)
  defaultWatermarkFontSize  String  @default("medium") // small, medium, large
  defaultApplyPreviewLut    Boolean @default(true) // Apply preview LUT during transcoding by default
  maxUploadSizeGB           Int     @default(1) // Maximum file size per upload in GB (1-1000)
  maxCommentAttachments     Int     @default(10) // Maximum files per comment attachment batch (1-50)
  maxReverseShareFiles      Int     @default(10) // Maximum files per reverse share upload session (1-500)

  // Default Comment Timestamp Display
  // TIMECODE = HH:MM:SS:FF (or DF), AUTO = MM:SS or HH:MM:SS based on video length
  defaultTimestampDisplay String @default("TIMECODE")

  // Default Approved Playback Setting
  defaultUsePreviewForApprovedPlayback Boolean @default(false)

  // Global ops switch for the optional high-bitrate source-quality proxy.
  // Off means no new proxy is generated and no source-quality playback token
  // can be minted. The uploaded original stays download-only.
  enableSourceQualityPlayback Boolean @default(false)

  // Default Client Asset Upload Setting
  defaultAllowClientAssetUpload Boolean @default(false)

  // Default Client Access Defaults
  defaultAllowReverseShare  Boolean @default(true) // Default: allow clients to submit files directly to project
  defaultShowClientTutorial Boolean @default(true) // Default: show interactive tutorial for first-time visitors
  defaultAllowAssetDownload Boolean @default(true) // Default: allow clients to download approved assets
  defaultClientCanApprove   Boolean @default(true) // Default: allow clients to approve videos

  // Project Behavior
  autoApproveProject Boolean @default(true) // Auto-approve project when all videos approved

  // Admin notification settings (global)
  // Note: Approval emails and manual admin notifications are always IMMEDIATE regardless of this setting
  adminNotificationSchedule String    @default("HOURLY") // IMMEDIATE, HOURLY, DAILY, WEEKLY
  adminNotificationTime     String? // "09:00" for daily, "Monday 09:00" for weekly
  adminNotificationDay      Int? // 0-6 for weekly (0 = Sunday)
  lastAdminNotificationSent DateTime?

  // Web Push VAPID Keys (auto-generated on first use)
  vapidPublicKey  String? // Public key for browser subscription
  vapidPrivateKey String? // Encrypted private key

  // Privacy Disclosure (shown on client share page)
  privacyDisclosureEnabled Boolean @default(false)
  privacyDisclosureText    String? // Custom text; null = use default i18n text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationDestination {
  id String @id @default(cuid())

  name     String
  enabled  Boolean @default(false)
  provider String // GOTIFY, NTFY, PUSHOVER, TELEGRAM

  // Non-secret provider configuration (e.g. baseUrl, topic, etc.)
  config Json

  // Encrypted JSON string containing secrets (e.g. tokens/keys). Use src/lib/encryption.ts.
  secretsEncrypted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions NotificationSubscription[]
  deliveries    NotificationDeliveryLog[]

  @@index([provider])
  @@index([enabled])
  @@index([createdAt])
}

model NotificationSubscription {
  id String @id @default(cuid())

  destinationId String
  destination   NotificationDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  eventType String // SHARE_ACCESS, ADMIN_ACCESS, CLIENT_COMMENT, VIDEO_APPROVAL, SECURITY_ALERT
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([destinationId, eventType])
  @@index([eventType, enabled])
}

model NotificationDeliveryLog {
  id String @id @default(cuid())

  destinationId String
  destination   NotificationDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  eventType  String
  success    Boolean @default(false)
  statusCode Int?
  error      String?

  sentAt DateTime @default(now())

  @@index([destinationId, sentAt])
  @@index([eventType, sentAt])
  @@index([success, sentAt])
}

model SecuritySettings {
  id String @id @default("default")

  // Hotlink Protection: DISABLED, LOG_ONLY, BLOCK_STRICT
  hotlinkProtection String @default("LOG_ONLY")

  // Rate Limiting (global only - per minute)
  ipRateLimit           Int  @default(1000) // requests per minute per IP (video streaming requires high limit)
  sessionRateLimit      Int  @default(600) // requests per minute per admin session (10/sec for seeking/buffering)
  shareSessionRateLimit Int  @default(300) // requests per minute per share session (client access)
  passwordAttempts      Int  @default(5) // password attempts before lockout
  shareTokenTtlSeconds  Int? // optional override for share JWT expiry (60-86400 seconds, null = use session timeout)

  // Session Timeout (for client share sessions, not admin JWT)
  sessionTimeoutValue Int    @default(15) // Numeric value (15, 30, 1, 2, etc.)
  sessionTimeoutUnit  String @default("MINUTES") // MINUTES, HOURS, DAYS, WEEKS

  // Admin Session Timeout (admin UI inactivity logout)
  adminSessionTimeoutValue Int    @default(7) // Numeric value (e.g., 7 days)
  adminSessionTimeoutUnit  String @default("DAYS") // MINUTES, HOURS, DAYS (max 30 days)

  // HTTPS Enforcement (HTTPS_ENABLED env var always takes precedence if set)
  httpsEnabled Boolean @default(true) // Enable HSTS (default: true for production security)

  // Logging toggles
  trackAnalytics    Boolean @default(true)
  trackSecurityLogs Boolean @default(true)

  // Security Dashboard Access
  viewSecurityEvents Boolean @default(false) // Show /admin/security page in navigation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SecurityEvent {
  id       String @id @default(cuid())
  type     String // HOTLINK_DETECTED, HOTLINK_BLOCKED, RATE_LIMIT_HIT, TOKEN_SESSION_MISMATCH, SUSPICIOUS_ACTIVITY, BLOCKED_IP_ATTEMPT
  severity String @default("INFO") // INFO, WARNING, CRITICAL

  projectId String?
  // Deleting a project must not delete the audit trail it produced, so the row
  // keeps the id but loses the relation.
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Plain column, not a foreign key: removing a user must not remove the record of
  // what that user did to the audit trail.
  userId    String?
  videoId   String?
  sessionId String?
  ipAddress String?
  referer   String?

  // Additional context as JSON
  details Json?

  // Was this event auto-blocked?
  wasBlocked Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([severity])
}

model BlockedIP {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  reason    String?
  createdAt DateTime @default(now())
  createdBy String? // Admin user ID who blocked this IP

  @@index([ipAddress])
}

model BlockedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  reason    String?
  createdAt DateTime @default(now())
  createdBy String? // Admin user ID who blocked this domain

  @@index([domain])
}

model VideoAnalytics {
  id String @id @default(cuid())

  // Null for photo download events (project-level, not tied to a video)
  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Event types: PAGE_VISIT, DOWNLOAD_COMPLETE, SOURCE_QUALITY_TOKEN,
  // SOURCE_QUALITY_PLAY, SOURCE_QUALITY_FAILURE
  eventType String

  // Source-quality observability. Other event types may leave these null.
  quality String?
  bytes   BigInt?

  // Optional: Single asset ID for individual asset downloads
  assetId String?

  // Optional: Multiple asset IDs for ZIP downloads (JSON array)
  assetIds String?

  // Photo download events: source album (null for whole-project zips) + photo IDs (JSON array)
  albumId  String?
  photoIds String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([videoId, createdAt])
  @@index([eventType])
  @@index([assetId])
}

model SharePageAccess {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Authentication method used: OTP, PASSWORD, GUEST
  accessMethod String

  // Email address (only for OTP authentication)
  email String?

  // JWT session ID for unique session tracking
  sessionId String

  // Which share link brought this visit. Null for the project's own master URL.
  // Not a FK relation on purpose: deleting a link must not erase its audit trail.
  shareLinkId String?

  // Client metadata
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, accessMethod])
  @@index([sessionId])
  @@index([shareLinkId, createdAt])
}

// Independent share records. A project may have many active links, each with
// its own scope, permissions, authentication, expiry, and view limit.
model ShareLink {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  token       String   @unique
  name        String
  type        String   @default("REVIEW") // REVIEW, DELIVERY, or COLLECT
  scopeType   String   @default("PROJECT") // PROJECT, FOLDER, VIDEO, VIDEO_VERSION
  scopeId     String?
  permissions String[] @default(["view", "comment"])

  // The project's own address is a row too, so it can be opened at the root of
  // the domain and carry expiry, revocation and access records like any link.
  // Only that one row per project sets this; ordinary links leave it NULL, and
  // Postgres treats NULLs as distinct, so the unique index gives "at most one
  // master link per project" without a partial index Prisma cannot model.
  masterOfProjectId String? @unique

  authMode      String    @default("PASSWORD")
  sharePassword String?
  expiresAt     DateTime?
  maxViews      Int?
  viewCount     Int       @default(0)
  status        String    @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([expiresAt])
  @@index([scopeType, scopeId])
}

model PasskeyCredential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // WebAuthn credential data (following SimpleWebAuthn patterns)
  credentialID Bytes  @unique // Authenticator's credential ID
  publicKey    Bytes // Public key for signature verification
  counter      BigInt // Signature counter (prevents replay attacks)

  // UX and security metadata
  transports     String[] // ['internal', 'usb', 'nfc', 'ble', 'hybrid']
  deviceType     String // 'singleDevice' | 'multiDevice' (cloud-synced passkey)
  backedUp       Boolean  @default(false) // Indicates key material is backed up
  aaguid         String? // Authenticator Attestation GUID (optional)
  userAgent      String? // Browser/device info for admin reference
  credentialName String? // User-friendly name: "MacBook Touch ID", "iPhone Passkey"

  // Security tracking
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  lastUsedIP String?

  @@index([userId])
  @@index([userId, lastUsedAt])
}

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique

  // Web Push subscription keys
  p256dh String
  auth   String

  // Device metadata for management UI
  userAgent  String?
  deviceName String?

  // Which surface owns this device: main console or the support PWA.
  surface String @default("main")

  // Event subscriptions (default: all events)
  subscribedEvents String[] @default(["SHARE_ACCESS", "ADMIN_ACCESS", "CLIENT_COMMENT", "VIDEO_APPROVAL", "CLIENT_UPLOAD", "SECURITY_ALERT"])

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([surface])
}

model PushDeliveryLog {
  id String @id @default(cuid())

  // Kept after the subscription is deleted so the audit trail survives.
  subscriptionId String?
  userId         String?
  deviceName     String?

  eventType String
  surface   String?
  projectId String?
  teamId    String?

  success    Boolean  @default(false)
  statusCode Int?
  error      String?
  sentAt     DateTime @default(now())

  @@index([eventType, sentAt])
  @@index([subscriptionId, sentAt])
  @@index([success, sentAt])
}

model EmailTemplate {
  id          String  @id @default(cuid())
  type        String  @unique // NEW_VERSION, PROJECT_APPROVED, COMMENT_NOTIFICATION, etc.
  name        String // Human-readable name for the template
  description String? // Description of when this template is used

  // Template content
  subject     String // Email subject line (supports placeholders)
  bodyContent String // HTML body content (supports placeholders)

  // Status flags
  isCustom Boolean @default(true) // false = system default, true = user customized
  enabled  Boolean @default(true) // Allow disabling specific templates

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, enabled])
}

// Client Directory - Companies/Organizations
model ClientCompany {
